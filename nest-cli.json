{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "projects": {
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "matte": {
      "type": "library",
      "root": "libs/matte",
      "entryFile": "index",
      "sourceRoot": "libs/matte/src",
      "compilerOptions": {
        "tsConfigPath": "libs/matte/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "service-a": {
      "type": "application",
      "root": "apps/service-a",
      "entryFile": "main",
      "sourceRoot": "apps/service-a/src",
      "compilerOptions": {
        "tsConfigPath": "apps/service-a/tsconfig.app.json"
      }
    },
    "service-b": {
      "type": "application",
      "root": "apps/service-b",
      "entryFile": "main",
      "sourceRoot": "apps/service-b/src",
      "compilerOptions": {
        "tsConfigPath": "apps/service-b/tsconfig.app.json"
      }
    },
    "service-c": {
      "type": "application",
      "root": "apps/service-c",
      "entryFile": "main",
      "sourceRoot": "apps/service-c/src",
      "compilerOptions": {
        "tsConfigPath": "apps/service-c/tsconfig.app.json"
      }
    },
    "tcp": {
      "type": "library",
      "root": "libs/tcp",
      "entryFile": "index",
      "sourceRoot": "libs/tcp/src",
      "compilerOptions": {
        "tsConfigPath": "libs/tcp/tsconfig.lib.json"
      }
    }
  }
}